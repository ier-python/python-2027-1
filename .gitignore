# ── Entornos de Python ────────────────────────────────────────────
# Cada clase tiene su propio .venv/, reconstruible con `uv sync`.
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ── Quarto ────────────────────────────────────────────────────────
/_book/
/.quarto/
*_files/

# ── Datos ─────────────────────────────────────────────────────────
# Los datos crudos y derivados no se versionan por omisión. La convención
# del curso es data/001_raw/, data/002_intermediate/, etc., así que se
# ignora data/ completo. Para versionar los datos de una clase concreta,
# añade su excepción, p. ej.:
#   !clases/009_importar_datos/data/001_raw/
clases/*/data/
!clases/*/data/**/.gitkeep
!clases/*/data/**/*.md

# ── Sistema ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

**/*.quarto_ipynb
